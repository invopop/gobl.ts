{
  "name": "@invopop/gobl.ts",
  "version": "0.505.0",
  "description": "GOBL library for TypeScript",
  "license": "Apache-2.0",
  "author": "Invopop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invopop/gobl.ts.git"
  },
  "homepage": "https://gobl.org",
  "keywords": [
    "gobl",
    "sdk",
    "typescript",
    "invoice",
    "e-invoicing"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/gen/*/index.d.ts",
      "import": "./dist/gen/*/index.js",
      "require": "./dist/gen/*/index.cjs"
    },
    "./registry/*": {
      "types": "./dist/gen/registry/*.d.ts",
      "import": "./dist/gen/registry/*.js",
      "require": "./dist/gen/registry/*.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "go run ./cmd/generate"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
