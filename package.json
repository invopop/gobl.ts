{
  "name": "@invopop/gobl",
  "version": "0.507.0",
  "description": "GOBL library for TypeScript",
  "license": "Apache-2.0",
  "author": "Invopop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invopop/gobl.ts.git"
  },
  "homepage": "https://gobl.org",
  "keywords": [
    "gobl",
    "sdk",
    "typescript",
    "invoice",
    "e-invoicing"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./registry/*": {
      "import": {
        "types": "./dist/gen/registry/*.d.ts",
        "default": "./dist/gen/registry/*.js"
      },
      "require": {
        "types": "./dist/gen/registry/*.d.cts",
        "default": "./dist/gen/registry/*.cjs"
      }
    },
    "./*": {
      "import": {
        "types": "./dist/gen/*/index.d.ts",
        "default": "./dist/gen/*/index.js"
      },
      "require": {
        "types": "./dist/gen/*/index.d.cts",
        "default": "./dist/gen/*/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run build:js && npm run build:types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "go run ./cmd/generate",
    "check-version": "node scripts/check-version.mjs",
    "build:js": "tsup",
    "build:types": "tsc -p tsconfig.build.json && node scripts/build-cjs-types.mjs",
    "verify-package": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
